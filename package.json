{
  "name": "fortu-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs && node scripts/build-jobs.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint && node scripts/check-copy.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:test:reset": "node --env-file-if-exists=.env.local scripts/test-db-reset.mjs",
    "test": "vitest run",
    "db:set-password": "node --env-file-if-exists=.env.local scripts/set-password.mjs",
    "lint:copy": "node scripts/check-copy.mjs",
    "e2e": "playwright test",
    "jobs:build": "node scripts/build-jobs.mjs",
    "insights:sync": "node --env-file-if-exists=.env.local jobs/insights-sync.js",
    "sweeper:run": "node --env-file-if-exists=.env.local jobs/sweeper.js"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "lucide-react": "^0.544.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.9",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
