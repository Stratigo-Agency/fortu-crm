DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
DATABASE_URL_TEST=postgres://postgres:dev@localhost:5432/fortu_test
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
WEBFORM_HMAC_SECRET=
# Meta Marketing API (nightly insights, T13). Leave empty to skip the job.
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v24.0
# WhatsApp Coexistence (T19, on web). Leave empty until a rep's number is connected.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ES_CONFIG_ID=
# Optional: key for the stored WhatsApp business tokens; empty = derived from AUTH_SECRET
WA_TOKEN_KEY=
# Reminder emails (sweeper, T16). Leave empty to skip the emails; the bell still works.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Accurate Online (nightly read-only sync, T20). Set on cron-accurate only. Never commit real values.
ACCURATE_API_TOKEN=
ACCURATE_SIGNATURE_SECRET=
# Optional: https://<server>.accurate.id ; empty = looked up from the token
ACCURATE_HOST=
# Optional: database id for X-Session-ID ; empty = looked up from the token
ACCURATE_DATABASE_ID=
# Staging only: 1 = demo rows (is_sample) count in the funnel and Prospek figures. Leave unset everywhere else.
SHOW_SAMPLE_DATA=
